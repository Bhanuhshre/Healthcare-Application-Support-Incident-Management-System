# Copy this file to .env and fill in real values before running docker-compose
# or the backend directly. Never commit a real .env file.

# PostgreSQL connection used by the backend
DATABASE_URL=postgresql://haism_user:haism_password@localhost:5432/haism_db

# Used to sign JWT access tokens. Generate a long random string for real
# deployments, for example with: openssl rand -hex 32
SECRET_KEY=change-this-secret-in-production

# How long a login session stays valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Postgres container settings (used by docker-compose)
POSTGRES_USER=haism_user
POSTGRES_PASSWORD=haism_password
POSTGRES_DB=haism_db
